# Server
PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# JWT — generate a strong random secret: node -e "require('crypto').randomBytes(64).toString('hex')"
SECRET_KEY=replace_with_a_64_byte_random_hex_string

# Google Gemini API
GOOGLE_API_KEY=replace_with_your_google_api_key
